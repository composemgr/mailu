# app.env.sample
# Copy to app.env and adjust values before starting the stack.
# These variables override the matching values in default.env for this app.
# No `export` prefix - this file is read by `docker compose --env-file`.

TZ=America/New_York
BASE_DOMAIN_NAME=example.com
BASE_HOST_NAME=mail.example.com

APP_ORG_NAME=Mailu

# 16 random bytes as hex, used to sign internal tokens between containers
APP_SECRET_KEY=replace-with-a-random-16-byte-hex-string

# The first admin account, only created when the database is empty
APP_ADMIN_USER=admin
APP_ADMIN_PASS=replace-with-a-random-password

# Token used by the API to authenticate machine clients
MAILU_API_TOKEN=replace-with-a-random-api-token

# Local part of the postmaster address, the domain is appended
MAILU_POSTMASTER=postmaster

# cert for a self-signed certificate, letsencrypt, notls or mail
MAILU_TLS_FLAVOR=cert

# The Docker network subnets, must not clash with your existing networks
IPV4_NETWORK=10.1.1.0/24
IPV6_NETWORK=fdab:03bb:c928:beef::/64

# Optional components
MAILU_ADMIN=true
MAILU_API=true
MAILU_WEBMAIL=snappymail
MAILU_WEBDAV=radicale
MAILU_ANTIVIRUS=clamav
MAILU_SCAN_MACROS=true
MAILU_FETCHMAIL_ENABLED=true

# Largest accepted message in bytes, 50000000 is about 50MB
MAILU_MESSAGE_SIZE_LIMIT=50000000
MAILU_MESSAGE_RATELIMIT=5000/day
MAILU_AUTH_RATELIMIT_IP=120/hour
MAILU_AUTH_RATELIMIT_USER=5000/day

# Character added to the address before @, blank disables plus addressing
MAILU_RECIPIENT_DELIMITER=+

# Outbound relay, leave both blank to deliver straight to MX
MAILU_RELAYHOST=
MAILU_RELAYNETS=

# Statistics reporting, True opts out
MAILU_DISABLE_STATISTICS=True

# Welcome mail sent to new mailboxes
MAILU_WELCOME=true
MAILU_WELCOME_SUBJECT=Welcome to your new email account

# Log verbosity, DEBUG, INFO, WARNING or ERROR
MAILU_LOG_LEVEL=INFO
